<view class="page {{themeDark ? 'dark' : ''}}">

  <view class="card">
    <view class="row-between">
      <view class="card-title">诊断日志（{{total}} 行）</view>
      <text class="muted">512 KB 轮转</text>
    </view>
    <view class="chips">
      <view wx:for="{{filters}}" wx:key="key" class="chip {{activeFilter === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="onFilterTap">{{item.label}}</view>
    </view>
    <view class="btn-row" style="margin-top:20rpx">
      <button class="btn small" bindtap="onCopyAll">复制全部</button>
      <button class="btn small" bindtap="onClear">清空</button>
    </view>
  </view>

  <view wx:if="{{shown.length === 0}}" class="card">
    <view class="empty">暂无日志</view>
  </view>

  <view class="card log-card">
    <view wx:for="{{shown}}" wx:key="id" wx:for-item="line" class="log-line {{line.tone}}" data-id="{{line.id}}" bindtap="onCopyLine">
      <text class="mono" selectable>{{line.text}}</text>
    </view>
    <view wx:if="{{total > 300}}" class="hint">仅显示最近 300 行，复制全部可拿到完整日志。</view>
  </view>

  <view class="card">
    <view class="card-title">存储位置</view>
    <view class="mono muted">{{path}}</view>
    <view class="hint">与 Android / iOS 客户端一样的行格式：时间 + 级别 + 模块 + 内容，便于对照排查。</view>
  </view>

</view>
